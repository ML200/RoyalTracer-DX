# Smoke test for PBRT v4 dielectric + thindielectric paths.

LookAt 0 1 5   0 0 0   0 1 0
Camera "perspective" "float fov" 35
Film "rgb" "integer xresolution" 800 "integer yresolution" 600

WorldBegin

LightSource "distant" "point3 from" [5 5 5] "point3 to" [0 0 0]
    "rgb L" [3 3 3]

# 1. Inline dielectric, no params (perfect mirror glass, IOR default).
AttributeBegin
  Material "dielectric"
  Translate -2 0.6 0
  Shape "sphere" "float radius" 0.5
AttributeEnd

# 2. Inline dielectric with eta only.
AttributeBegin
  Material "dielectric" "float eta" 1.55
  Translate -1 0.6 0
  Shape "sphere" "float radius" 0.5
AttributeEnd

# 3. Named material via MakeNamedMaterial / NamedMaterial.
MakeNamedMaterial "glass3"
    "string type" "dielectric"
    "float eta" 1.5

AttributeBegin
  NamedMaterial "glass3"
  Translate 0 0.6 0
  Shape "sphere" "float radius" 0.5
AttributeEnd

# 4. thindielectric.
AttributeBegin
  Material "thindielectric"
  Translate 1 0.6 0
  Shape "sphere" "float radius" 0.5
AttributeEnd

# 5. dielectric with explicit roughness (frosted glass).
AttributeBegin
  Material "dielectric" "float roughness" 0.04 "float eta" 1.5
  Translate 2 0.6 0
  Shape "sphere" "float radius" 0.5
AttributeEnd
